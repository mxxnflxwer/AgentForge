# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://agentforge:agentforge_dev_password@localhost:5432/agentforge

# Application Security
SECRET_KEY=agentforge-development-secret-change-later
DEVELOPER_SECRET_KEY=agentforge_dev_secret_key

# Environment & CORS
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Server Session Configuration
SESSION_COOKIE_NAME=session_id
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# LLM Provider Configuration
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_NAME=gemini-3.5-flash-lite

QWEN_API_KEY=
QWEN_API_BASE_URL=https://openrouter.ai/api/v1
QWEN_MODEL_NAME=qwen/qwen3.6-27b

# NVIDIA NIM Hosted Model (Nemotron 3.5 Lightning 30B A3B)
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ID=nvidia/nemotron-3.5-lightning-30b-a3b

LLM_TIMEOUT_SECONDS=30.0
